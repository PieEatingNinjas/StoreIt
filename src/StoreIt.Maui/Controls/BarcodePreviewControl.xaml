<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="StoreIt.Maui.Controls.BarcodePreviewControl"
    xmlns:controls="clr-namespace:StoreIt.Maui.Controls"
    x:Name="Root"
    x:DataType="controls:BarcodePreviewControl"
    InputTransparent="True">
    <VerticalStackLayout Spacing="5">
        <Border
            Padding="15"
            Background="{AppThemeBinding Light={StaticResource SelectionBackgroundLight},
                                         Dark={StaticResource SelectionBackgroundDark}}"
            Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight},
                                     Dark={StaticResource SurfaceBorderDark}}"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <!--  Barcode Visual Preview  -->
                <Border
                    Padding="10"
                    BackgroundColor="White"
                    HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="4" />
                    </Border.StrokeShape>
                    <controls:SafeBarcodeView
                        x:Name="previewBarcodeGenerator"
                        HeightRequest="80"
                        WidthRequest="200" />
                </Border>

                <!--  Preview Text  -->
                <Label
                    x:Name="barcodePreviewText"
                    FontFamily="Monospace"
                    FontSize="14"
                    HorizontalOptions="Center"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight},
                                                Dark={StaticResource PrimaryTextDark}}" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>
