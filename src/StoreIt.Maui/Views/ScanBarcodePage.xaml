<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
      x:Class="StoreIt.Maui.Views.ScanBarcodePage"
      xmlns:vm="clr-namespace:StoreIt.Maui.ViewModels"
      xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
      Title="Scan je barcode"
      x:DataType="vm:ScanBarcodeViewModel"
      >
      <ContentPage.Resources>
            <Style x:Key="CornerIndicatorStyle" TargetType="Path">
                  <Setter Property="Stroke" Value="{StaticResource Accent}" />
                  <Setter Property="StrokeThickness" Value="4" />
            </Style>
      </ContentPage.Resources>

      <Grid RowDefinitions="Auto,*,Auto">
            <!--  Header  -->
            <Grid
                  Grid.Row="0"
                  Padding="15,10"
                  ColumnDefinitions="Auto,*, Auto">
            </Grid>

            <!--  Camera View  -->
            <zxing:CameraBarcodeReaderView
                  x:Name="cameraView"
                  Grid.Row="1"
                  BarcodesDetected="OnBarcodesDetected"
                  CameraLocation="Rear"
                  IsDetecting="{Binding IsScanning}" />

            <!--  Scanning Overlay  -->
            <Grid
                  Grid.Row="1"
                  InputTransparent="True"
                  IsVisible="{Binding IsScanning}">

                  <!--  Scanning Frame  -->
                  <Border
                        BackgroundColor="Transparent"
                        HeightRequest="140"
                        HorizontalOptions="Center"
                        Stroke="White"
                        StrokeThickness="2"
                        VerticalOptions="Center"
                        WidthRequest="280">
                        <Border.StrokeShape>
                              <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                  </Border>

                  <!--  Corner indicators  -->
                  <Grid
                        HeightRequest="140"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="280">
                        <!--  Top Left  -->
                        <Path
                              Data="M 0,20 L 0,0 L 20,0"
                              HorizontalOptions="Start"
                              Style="{StaticResource CornerIndicatorStyle}"
                              VerticalOptions="Start" />

                        <!--  Top Right  -->
                        <Path
                              Data="M 0,0 L 20,0 L 20,20"
                              HorizontalOptions="End"
                              Style="{StaticResource CornerIndicatorStyle}"
                              VerticalOptions="Start" />

                        <!--  Bottom Left  -->
                        <Path
                              Data="M 0,0 L 0,20 L 20,20"
                              HorizontalOptions="Start"
                              Style="{StaticResource CornerIndicatorStyle}"
                              VerticalOptions="End" />

                        <!--  Bottom Right  -->
                        <Path
                              Data="M 0,20 L 20,20 L 20,0"
                              HorizontalOptions="End"
                              Style="{StaticResource CornerIndicatorStyle}"
                              VerticalOptions="End" />
                  </Grid>

                  <!--  Instructions  -->
                  <Label
                        Margin="20,0,20,100"
                        Padding="15,10"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="Houd de barcode binnen het kader"
                        TextColor="White"
                        VerticalOptions="End" />
            </Grid>
      </Grid>
</ContentPage>
