<?xml version="1.0" encoding="utf-8" ?>
<bottomsheet:BottomSheet
    x:Class="StoreIt.Maui.Views.ViewCardPage"
    xmlns:bottomsheet="http://pluginmauibottomsheet.com"
    xmlns:controls="clr-namespace:StoreIt.Maui.Controls"
    xmlns:vm="clr-namespace:StoreIt.Maui.ViewModels"
    x:DataType="vm:ViewCardViewModel"
    Background="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}"
    CornerRadius="28"
    HasHandle="True"
    IsCancelable="True"
    IsDraggable="True"
    IsModal="True"
    Padding="16,8,16,0"
    ShowHeader="True"
    States="Peek,Large"
    CurrentState="Peek">
    <bottomsheet:BottomSheet.Resources>
        <Style x:Key="CardActionStyle" TargetType="Button">
            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="56" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="ContentLayout" Value="Left,12" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />
        </Style>
    </bottomsheet:BottomSheet.Resources>
    <bottomsheet:BottomSheet.Triggers>
        <DataTrigger TargetType="bottomsheet:BottomSheet" Binding="{Binding EditCardCommand.IsRunning}" Value="True">
            <Setter Property="IsCancelable" Value="False" />
        </DataTrigger>
        <DataTrigger TargetType="bottomsheet:BottomSheet" Binding="{Binding DeleteCardCommand.IsRunning}" Value="True">
            <Setter Property="IsCancelable" Value="False" />
        </DataTrigger>
        <DataTrigger TargetType="bottomsheet:BottomSheet" Binding="{Binding ToggleFavoriteCommand.IsRunning}" Value="True">
            <Setter Property="IsCancelable" Value="False" />
        </DataTrigger>
    </bottomsheet:BottomSheet.Triggers>
    <bottomsheet:BottomSheet.Header>
        <bottomsheet:BottomSheetHeader
            TitleText="Kaart"
            CloseButtonPosition="TopLeft"
            HeaderAppearance="RightButton"
            ShowCloseButton="True">
            <bottomsheet:BottomSheetHeader.TopRightButton>
                <Button
                    AutomationId="FavoriteCardAction"
                    Command="{Binding ToggleFavoriteCommand}"
                    HorizontalOptions="End"
                    VerticalOptions="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}" />
                            <Setter Property="ImageSource" Value="{AppThemeBinding Light=star_outline.png, Dark=star_outline_dark.png}" />
                            <Setter Property="CornerRadius" Value="22" />
                            <Setter Property="HeightRequest" Value="44" />
                            <Setter Property="WidthRequest" Value="44" />
                            <Setter Property="Padding" Value="10" />
                            <Setter Property="BorderWidth" Value="0" />
                            <Setter Property="SemanticProperties.Description" Value="Toevoegen aan favorieten" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding Card.IsFavorite}" Value="True">
                                    <Setter Property="ImageSource" Value="star_filled.png" />
                                    <Setter Property="SemanticProperties.Description" Value="Verwijderen uit favorieten" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </bottomsheet:BottomSheetHeader.TopRightButton>
        </bottomsheet:BottomSheetHeader>
    </bottomsheet:BottomSheet.Header>
    <bottomsheet:BottomSheet.Content>
        <bottomsheet:BottomSheetContent>
            <Grid Padding="8,12,8,0" SafeAreaEdges="None"
                  Background="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">
                <ScrollView x:Name="cardScroll" VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never" IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                    <Grid
                        HorizontalOptions="Fill"
                        MaximumWidthRequest="560"
                        MinimumHeightRequest="{Binding Height, Source={x:Reference cardScroll}, x:DataType=ScrollView}"
                        RowDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Spacing="20">
                            <Border Padding="24" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Card.Color}" />
                                </Border.Background>
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="28"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding Card.Name}"
                                        TextColor="White"
                                        SemanticProperties.HeadingLevel="Level1" />
                                    <Label
                                        FontSize="16"
                                        HorizontalTextAlignment="Center"
                                        IsVisible="{Binding Card.Description, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                        Text="{Binding Card.Description}"
                                        TextColor="#CCFFFFFF" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Padding="20,28" StrokeShape="RoundRectangle 20">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Card.HasBarcode}" TargetType="Border" Value="True">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Stroke" Value="{StaticResource VeryLightGray}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid x:Name="codeContainer" SizeChanged="OnCodeContainerSizeChanged">
                                    <VerticalStackLayout Spacing="20" InputTransparent="True">
                                        <controls:SafeBarcodeView
                                            x:Name="barcodeGenerator"
                                            Background="White"
                                            Format="{Binding Card.BarcodeFormat, Converter={StaticResource StringToBarcodeFormatConverter}}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Start"
                                            InputTransparent="True"
                                            IsVisible="{Binding Card.HasBarcode}"
                                            Value="{Binding Card.BarcodeData}" />
                                        <Label
                                            FontFamily="{OnPlatform Android=monospace, Default=Courier}"
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            InputTransparent="True"
                                            IsVisible="{Binding Card.HasBarcode}"
                                            Text="{Binding Card.BarcodeData}"
                                            TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontFamily="{OnPlatform Android=monospace, Default=Courier}"
                                            FontSize="32"
                                            HorizontalTextAlignment="Center"
                                            InputTransparent="True"
                                            IsVisible="{Binding Card.HasCustomCode}"
                                            Text="{Binding Card.CustomCode}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                    </VerticalStackLayout>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCodeTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>

                            <Grid>
                                <controls:HintControl
                                    HorizontalOptions="Center"
                                    Icon="👆"
                                    IsShowing="{Binding ShowZoomHint}"
                                    ShowDuration="1500"
                                    Text="Tik om te zoomen" />
                                <controls:HintControl
                                    HorizontalOptions="Center"
                                    Icon="👆"
                                    IsShowing="{Binding ShowCopyHint}"
                                    ShowDuration="1500"
                                    Text="Tik om de code te kopiëren" />
                                <controls:HintControl
                                    x:Name="copyHint"
                                    HorizontalOptions="Center"
                                    Icon="📋"
                                    ShowDuration="1500"
                                    Text="Code gekopieerd" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Margin="0,20,0,0" Spacing="10">
                            <Label
                                Margin="4,0,0,2"
                                FontSize="12"
                                FontAttributes="Bold"
                                CharacterSpacing="1"
                                Text="KAART BEHEREN"
                                TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                SemanticProperties.HeadingLevel="Level2" />
                            <Button
                                AutomationId="EditCardAction"
                                Command="{Binding EditCardCommand}"
                                ImageSource="{AppThemeBinding Light=edit.png, Dark=edit_dark.png}"
                                Style="{StaticResource CardActionStyle}"
                                Text="Kaart bewerken" />
                            <Button
                                AutomationId="DeleteCardAction"
                                Margin="0,6,0,0"
                                Background="{AppThemeBinding Light=#FFF1F2, Dark=#321F25}"
                                BorderColor="{AppThemeBinding Light=#FFE4E6, Dark=#57303A}"
                                Command="{Binding DeleteCardCommand}"
                                ImageSource="delete_card.png"
                                Style="{StaticResource CardActionStyle}"
                                Text="Kaart verwijderen"
                                TextColor="{AppThemeBinding Light=#BE123C, Dark=#FDA4AF}" />
                        </VerticalStackLayout>
                    </Grid>
                </ScrollView>
                <ActivityIndicator
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}" />
                <Label
                    FontSize="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsAuthenticating}"
                    Text="Authenticatie vereist"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            </Grid>
        </bottomsheet:BottomSheetContent>
    </bottomsheet:BottomSheet.Content>
</bottomsheet:BottomSheet>
