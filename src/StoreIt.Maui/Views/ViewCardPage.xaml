<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StoreIt.Maui.Views.ViewCardPage"
    xmlns:controls="clr-namespace:StoreIt.Maui.Controls"
    xmlns:duo="clr-namespace:DuoExtensions.Maui;assembly=DuoExtensions.Maui"
    xmlns:vm="clr-namespace:StoreIt.Maui.ViewModels"
    Title="Kaart"
    x:DataType="vm:ViewCardViewModel"
    SafeAreaEdges="Container"
    Shell.TabBarIsVisible="False">
    <ContentPage.ToolbarItems>
        <ToolbarItem
            duo:ToolbarItemAxisBehavior.AxisBehavior="Automatic"
            AutomationId="FavoriteCardToolbarItem"
            Command="{Binding ToggleFavoriteCommand}"
            Priority="1"
            Text="Favoriet"
            SemanticProperties.Description="Favoriet wijzigen">
            <ToolbarItem.Style>
                <Style TargetType="ToolbarItem">
                    <Setter Property="IconImageSource" Value="{AppThemeBinding Light=star_outline.png, Dark=star_outline_dark.png}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="ToolbarItem" Binding="{Binding Card.HasBarcode}" Value="True">
                            <Setter Property="IconImageSource" Value="star_outline_dark.png" />
                        </DataTrigger>
                        <DataTrigger TargetType="ToolbarItem" Binding="{Binding Card.IsFavorite}" Value="True">
                            <Setter Property="IconImageSource" Value="star_filled.png" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToolbarItem.Style>
        </ToolbarItem>
        <ToolbarItem
            duo:ToolbarItemAxisBehavior.AxisBehavior="Automatic"
            AutomationId="EditCardToolbarItem"
            Command="{Binding EditCardCommand}"
            Priority="2"
            Text="Bewerken"
            SemanticProperties.Description="Kaart bewerken">
            <ToolbarItem.Style>
                <Style TargetType="ToolbarItem">
                    <Setter Property="IconImageSource" Value="{AppThemeBinding Light=edit.png, Dark=edit_dark.png}" />
                    <Style.Triggers>
                        <DataTrigger TargetType="ToolbarItem" Binding="{Binding Card.HasBarcode}" Value="True">
                            <Setter Property="IconImageSource" Value="edit_dark.png" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToolbarItem.Style>
        </ToolbarItem>
        <ToolbarItem
            AutomationId="DeleteCardToolbarItem"
            Command="{Binding DeleteCardCommand}"
            Order="Secondary"
            Priority="3"
            Text="Verwijderen"
            SemanticProperties.Description="Kaart verwijderen" />
    </ContentPage.ToolbarItems>
    <ContentPage.Style>
        <Style TargetType="ContentPage">
            <Setter Property="Background" Value="{AppThemeBinding Light=White, Dark={StaticResource Gray950}}" />
            <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource Gray950}}" />
            <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Card.HasBarcode}" TargetType="ContentPage" Value="True">
                    <Setter Property="Background" Value="Black" />
                    <Setter Property="Shell.BackgroundColor" Value="Black" />
                    <Setter Property="Shell.ForegroundColor" Value="White" />
                    <Setter Property="Shell.TitleColor" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Style>

    <Grid Padding="24">
        <ScrollView IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <VerticalStackLayout
                HorizontalOptions="Fill"
                MaximumWidthRequest="560"
                Spacing="24"
                VerticalOptions="Center">
                <Border Padding="24" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding Card.Color}" />
                    </Border.Background>
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            HorizontalTextAlignment="Center"
                            Text="{Binding Card.Name}"
                            TextColor="White"
                            SemanticProperties.HeadingLevel="Level1" />
                        <Label
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding Card.Description, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                            Text="{Binding Card.Description}"
                            TextColor="#CCFFFFFF" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="20,28" StrokeShape="RoundRectangle 20">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Card.HasBarcode}" TargetType="Border" Value="True">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Stroke" Value="{StaticResource VeryLightGray}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid x:Name="codeContainer" SizeChanged="OnCodeContainerSizeChanged">
                        <VerticalStackLayout Spacing="20" InputTransparent="True">
                            <controls:SafeBarcodeView
                                x:Name="barcodeGenerator"
                                Background="White"
                                Format="{Binding Card.BarcodeFormat, Converter={StaticResource StringToBarcodeFormatConverter}}"
                                HorizontalOptions="Center"
                                InputTransparent="True"
                                IsVisible="{Binding Card.HasBarcode}"
                                Value="{Binding Card.BarcodeData}" />
                            <Label
                                FontFamily="{OnPlatform Android=monospace, Default=Courier}"
                                FontSize="16"
                                HorizontalTextAlignment="Center"
                                InputTransparent="True"
                                IsVisible="{Binding Card.HasBarcode}"
                                Text="{Binding Card.BarcodeData}"
                                TextColor="#666666" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="{OnPlatform Android=monospace, Default=Courier}"
                                FontSize="32"
                                HorizontalTextAlignment="Center"
                                InputTransparent="True"
                                IsVisible="{Binding Card.HasCustomCode}"
                                Text="{Binding Card.CustomCode}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCodeTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <Grid>
                    <controls:HintControl
                        HorizontalOptions="Center"
                        Icon="👆"
                        IsShowing="{Binding ShowZoomHint}"
                        ShowDuration="1500"
                        Text="Tik om te zoomen" />
                    <controls:HintControl
                        HorizontalOptions="Center"
                        Icon="👆"
                        IsShowing="{Binding ShowCopyHint}"
                        ShowDuration="1500"
                        Text="Tik om de code te kopiëren" />
                    <controls:HintControl
                        x:Name="copyHint"
                        HorizontalOptions="Center"
                        Icon="📋"
                        ShowDuration="1500"
                        Text="Code gekopieerd" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <ActivityIndicator
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}" />
        <Label
            FontSize="18"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsVisible="{Binding IsAuthenticating}"
            Text="Authenticatie vereist"
            TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
    </Grid>
</ContentPage>
